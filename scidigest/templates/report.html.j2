<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
{% include "_base_css.html.j2" %}
{% include "_head_app.html.j2" %}
<style>
h1{font-size:2.1rem;line-height:1.12;letter-spacing:-.025em;margin:4px 0 6px}
.sub{color:var(--soft);font-size:.95rem}
.intro{max-width:760px;font-size:1.05rem;margin:14px 0 0}
.note{display:inline-block;margin-top:12px;background:var(--warn-bg);color:var(--warn);padding:6px 10px;border-radius:10px;font-size:.85rem}
.chips{display:flex;gap:8px;overflow-x:auto;padding:16px 2px 6px;scrollbar-width:none}
.chips button{flex:none;border:1px solid var(--glass-border);background:var(--glass);-webkit-backdrop-filter:var(--blur);backdrop-filter:var(--blur);color:var(--soft);padding:8px 14px;border-radius:999px;font:inherit;font-size:.85rem;cursor:pointer}
.chips button[aria-pressed=true]{background:var(--ink);color:var(--bg);border-color:transparent}
h2{font-size:1.2rem;letter-spacing:-.015em;margin:32px 0 12px}
h3{font-size:.76rem;text-transform:uppercase;letter-spacing:.07em;color:var(--muted);margin:22px 0 10px}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(310px,1fr));gap:18px;align-items:start}
.card{border-radius:24px;overflow:hidden;transition:transform .2s,box-shadow .2s}
.card:hover{transform:translateY(-2px);box-shadow:0 1px 0 rgba(255,255,255,.65) inset,0 16px 40px rgba(30,41,59,.14)}
.card.open{grid-column:1/-1;background:var(--glass-strong);transform:none}
.card summary{list-style:none;cursor:pointer;display:block}
.card summary::-webkit-details-marker{display:none}
.thumb{aspect-ratio:16/9;background:var(--ph);overflow:hidden;position:relative;margin:8px 8px 0;border-radius:18px}
.thumb img{width:100%;height:100%;object-fit:cover;display:block}
.thumb .ph{position:absolute;inset:0;display:grid;place-items:center;font-size:2.4rem;font-weight:700;color:var(--muted);background:linear-gradient(135deg,var(--accent-bg),transparent)}
.card.open .thumb{aspect-ratio:auto;max-height:460px}
.card.open .thumb img{object-fit:contain;max-height:460px}
.body{padding:14px 18px 18px}
.kicker{display:flex;flex-wrap:wrap;gap:6px;align-items:center;font-size:.72rem;font-weight:700;margin-bottom:7px}
.topic{color:var(--accent);text-transform:uppercase;letter-spacing:.06em}
.pill{padding:2px 8px;border-radius:999px;font-weight:600}
.pill.pre{background:var(--warn-bg);color:var(--warn)}.pill.full{background:var(--ok-bg);color:var(--ok)}.pill.rep{background:var(--accent-bg);color:var(--accent)}
.card h4{font-size:1.1rem;line-height:1.3;margin:0 0 6px;letter-spacing:-.015em;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}
.card.open h4{display:block;font-size:1.35rem}
.lede{color:var(--soft);font-size:.93rem;margin:0;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}
.meta{display:flex;justify-content:space-between;gap:10px;align-items:center;color:var(--muted);font-size:.8rem;margin-top:12px}
.dots{display:inline-flex;gap:2px}.dots i{width:5px;height:10px;border-radius:3px;background:var(--line)}.dots i.on{background:var(--accent)}
.more{display:inline-flex;align-items:center;gap:4px;color:var(--accent);font-weight:600;font-size:.85rem;margin-top:12px}
.more::after{content:"›";font-size:1.1rem;line-height:1}
.card.open .more,.card.open .lede{display:none}
.full{padding:0 18px 20px;max-width:780px}
.full p{margin:0 0 12px}
.full h5{font-size:.74rem;text-transform:uppercase;letter-spacing:.07em;color:var(--muted);margin:20px 0 6px}
.full dl{margin:0;font-size:.93rem}.full dt{font-weight:600;display:inline}.full dd{display:inline;margin:0}.full dd::after{content:"";display:block;margin-bottom:6px}
.orig{color:var(--muted);font-size:.85rem;font-style:italic}
.credit{color:var(--muted);font-size:.75rem;padding:8px 18px 0}
.src{background:var(--ph);border-radius:14px;padding:12px 14px;font-size:.85rem;margin-top:16px;overflow-wrap:anywhere}
sup a{text-decoration:none;font-size:.7rem}
.refs-wrap{border-radius:22px;padding:6px 18px 10px;margin-top:8px}
.refs{font-size:.85rem;color:var(--soft);padding-left:20px}.refs li{margin-bottom:8px;overflow-wrap:anywhere}
footer{color:var(--muted);font-size:.8rem;margin-top:30px;max-width:760px}
</style>
</head>
<body><div class="wrap">
{% include "_topbar.html.j2" %}
<header>
  <h1>{{ title }}</h1>
  <div class="sub">{{ subtitle }}</div>
  {% if intro %}<p class="intro">{{ intro }}</p>{% endif %}
  {% if not ai %}<div class="note">Summaries here are the publishers' abstracts, not plain-language rewrites.</div>{% endif %}
</header>

{% include "_mytopics.html.j2" %}
{% if topics|length > 1 %}
<nav class="chips" aria-label="Filter by topic">
  <button type="button" data-topic="" aria-pressed="true">All topics</button>
  {% for tid, tname in topics %}<button type="button" data-topic="{{ tid }}" aria-pressed="false">{{ tname }}</button>{% endfor %}
</nav>
{% endif %}

{% macro card(e) %}
<details class="card" id="p{{ e.n }}" data-topic="{{ e.topic }}" data-editors="{{ 1 if e.editors_pick else 0 }}" data-rank="{{ e.n }}" data-score="{{ e.pick.score }}">
  <summary>
    <div class="thumb"><div class="ph" aria-hidden="true">{{ e.topic_name[:1] }}</div>{% if e.image %}<img src="{{ e.image.url }}" alt="{{ e.image.caption or e.s.headline }}" loading="lazy" onerror="this.remove()" style="position:relative">{% endif %}</div>
    <div class="body">
      <div class="kicker"><span class="topic">{{ e.topic_name }}</span>
        {% if e.preprint %}<span class="pill pre">Preprint</span>{% endif %}
        {% if e.s.based_on == "full text" %}<span class="pill full">Full text</span>{% endif %}
        {% if e.featured_label and not is_review %}<span class="pill rep">Featured before</span>{% endif %}</div>
      <h4>{{ e.s.headline }}</h4>
      <p class="lede">{{ e.intro }}</p>
      <div class="meta"><span>{{ e.article.journal }} · {{ e.published_label|replace("Published ", "") }}</span>
        <span class="dots" title="Significance {{ e.pick.score }}/10">{% for i in range(10) %}<i class="{{ 'on' if i < e.pick.score }}"></i>{% endfor %}</span></div>
      <div class="more">Read more</div>
    </div>
  </summary>
  {% if e.image %}<div class="credit">{% if e.image.kind == "illustration" %}Illustration, not from the paper. {% endif %}{{ e.image.caption }} · {{ e.image.credit }}{% if e.image.license %} · {% if e.image.license_url %}<a href="{{ e.image.license_url }}" target="_blank" rel="noopener">{{ e.image.license }}</a>{% else %}{{ e.image.license }}{% endif %}{% endif %}</div>{% endif %}
  <div class="full">
    <p class="orig">Original title: “{{ e.article.title }}”<br>{{ e.published_label }}{% if e.featured_label %} · {{ e.featured_label }}{% endif %}</p>
    {% for para in e.s.summary.split("\n") if para.strip() %}<p>{{ para }}{% if loop.last %}<sup><a href="#ref{{ e.n }}">[{{ e.n }}]</a></sup>{% endif %}</p>{% endfor %}
    <h5>Why it matters</h5><p>{{ e.s.why_it_matters }}</p>
    {% if e.s.limitations %}<h5>Caveats</h5><p>{{ e.s.limitations }}</p>{% endif %}
    {% if e.s.key_terms %}<h5>Key terms</h5><dl>{% for t in e.s.key_terms %}<dt>{{ t.term }}:</dt> <dd>{{ t.meaning }}</dd>{% endfor %}</dl>{% endif %}
    {% if e.pick.reason %}<h5>Why it was picked</h5><p>{{ e.pick.reason }}</p>{% endif %}
    <div class="src">{{ e.citation|md_italics }}<br><a href="{{ e.url }}" target="_blank" rel="noopener">Read the original</a>{% if e.free %} · <a href="{{ e.free.url }}" target="_blank" rel="noopener">Free to read: {{ e.free.version }}</a>{% endif %}</div>
  </div>
</details>
{% endmacro %}

<main data-report>
  {% if editors %}<h2 class="editors">{{ "Top papers" if is_review else "Editor's picks" }}</h2>
  <div class="grid editors-grid">{% for e in editors %}{{ card(e) }}{% endfor %}</div>{% endif %}
  {% if by_topic %}<h2 class="by-topic">More by topic</h2>
  {% for name, items in by_topic %}<section class="topic-section"><h3>{{ name }}</h3><div class="grid">{% for e in items %}{{ card(e) }}{% endfor %}</div></section>{% endfor %}{% endif %}

</main>
<section>
  <h2>References</h2>
  <div class="glass refs-wrap">
  <ol class="refs">{% for e in entries %}<li id="ref{{ e.n }}" value="{{ e.n }}">{{ e.citation|md_italics }}</li>{% endfor %}</ol>
  </div>
</section>
<footer>Summaries are paraphrased{% if ai %} by AI{% endif %} from each paper's abstract, plus its full text when a free, legal copy was available. Preprints have not been peer reviewed. Images are open-access figures from the paper or free-licensed illustrations, credited on each card. Check the original paper before citing it in your own work.</footer>
</div>
{% include "_settings.html.j2" %}
<script>
document.querySelectorAll("details.card").forEach(function(d){d.addEventListener("toggle",function(){d.classList.toggle("open",d.open)})});
(function(){var KEY="scidigest-topic",btns=[].slice.call(document.querySelectorAll(".chips button"));if(!btns.length)return;
function apply(t){btns.forEach(function(b){b.setAttribute("aria-pressed",String(b.dataset.topic===t))});
document.querySelectorAll("details.card").forEach(function(c){c.classList.toggle("hidden",!!t&&c.dataset.topic!==t)});
document.querySelectorAll(".topic-section").forEach(function(s){s.classList.toggle("hidden",!s.querySelector("details.card:not(.hidden)"))});
document.querySelectorAll("h2.by-topic").forEach(function(h){h.classList.toggle("hidden",!document.querySelector(".topic-section:not(.hidden)"))});
try{localStorage.setItem(KEY,t)}catch(e){}}
btns.forEach(function(b){b.addEventListener("click",function(){apply(b.dataset.topic)})});
var saved="";try{saved=localStorage.getItem(KEY)||""}catch(e){}
if(saved&&btns.some(function(b){return b.dataset.topic===saved}))apply(saved);})();
</script>
</body></html>
