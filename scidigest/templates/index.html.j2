<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>SciDigest</title>
{% include "_base_css.html.j2" %}
{% include "_head_app.html.j2" %}
<style>
h1{font-size:2rem;letter-spacing:-.02em;margin:4px 0 4px}
.lead{color:var(--soft);margin:0}
h2{font-size:1.15rem;letter-spacing:-.01em;margin:30px 0 12px}
.list{display:grid;gap:10px}.list>*{min-width:0}
.row{display:block;overflow:hidden;background:var(--card);border:1px solid var(--line);border-radius:14px;padding:14px 16px;text-decoration:none;color:inherit;transition:border-color .15s}
.row:hover{border-color:var(--muted)}
.row .top{display:flex;justify-content:space-between;gap:12px;align-items:baseline}
.row .d{font-weight:600}.row .n{color:var(--muted);font-size:.82rem;white-space:nowrap}
.row ul{margin:6px 0 0;padding-left:18px;color:var(--soft);font-size:.9rem}
.row ul{min-width:0}.row li{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.tag{display:inline-block;font-size:.72rem;font-weight:600;text-transform:uppercase;letter-spacing:.05em;color:var(--accent);margin-bottom:2px}
.latest{border-color:var(--accent)}
footer{color:var(--muted);font-size:.8rem;margin-top:34px}
</style>
</head>
<body><div class="wrap">
{% set home = "index.html" %}{% include "_topbar.html.j2" %}
<h1>Science, explained daily</h1>
<p class="lead">The most important new research from leading journals, in plain language for science students. Daily picks, a weekly review every Sunday and a monthly review on the 1st.</p>
{% include "_mytopics.html.j2" %}

{% if days %}<h2>Latest</h2>
<div class="list">{% set d = days[0] %}<a class="row latest" href="reports/{{ d.id }}.html"><span class="tag">Today's digest</span>
  <div class="top"><span class="d">{{ d.label }}</span><span class="n">{{ d.count }} papers</span></div>
  <ul>{% for h in d.headlines %}<li>{{ h }}</li>{% endfor %}</ul></a></div>{% endif %}

{% for title, items in sections if items %}
<h2>{{ title }}</h2>
<div class="list">{% for d in items %}<a class="row" href="reports/{{ d.id }}.html">
  <div class="top"><span class="d">{{ d.label }}</span><span class="n">{{ d.count }} papers</span></div>
  <ul>{% for h in d.headlines %}<li>{{ h }}</li>{% endfor %}</ul></a>{% endfor %}</div>
{% endfor %}
<footer>Summaries are written by AI from published abstracts and open-access papers, with citations and links to every source. <a href="privacy.html">Privacy</a></footer>
</div>
{% include "_settings.html.j2" %}
</body></html>
