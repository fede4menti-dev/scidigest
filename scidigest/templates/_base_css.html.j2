<style>
:root{--bg:#f6f7f9;--card:#fff;--ink:#14171a;--soft:#4b5563;--muted:#8a919c;--line:#e7e9ee;--accent:#0f766e;--accent-ink:#fff;--accent-bg:#e6f4f2;--warn:#b45309;--warn-bg:#fdf3e4;--ok:#15803d;--ok-bg:#e8f6ec;--ph:#e9edf2;--shadow:0 10px 40px rgba(15,23,42,.18)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0f1113;--card:#181b1f;--ink:#eef0f2;--soft:#b9c0c9;--muted:#7d8590;--line:#2a2e34;--accent:#5eead4;--accent-ink:#06201d;--accent-bg:#11302d;--warn:#fbbf24;--warn-bg:#33270f;--ok:#86efac;--ok-bg:#12301c;--ph:#22262b;--shadow:0 10px 40px rgba(0,0,0,.5)}}
:root[data-theme="dark"]{--bg:#0f1113;--card:#181b1f;--ink:#eef0f2;--soft:#b9c0c9;--muted:#7d8590;--line:#2a2e34;--accent:#5eead4;--accent-ink:#06201d;--accent-bg:#11302d;--warn:#fbbf24;--warn-bg:#33270f;--ok:#86efac;--ok-bg:#12301c;--ph:#22262b;--shadow:0 10px 40px rgba(0,0,0,.5)}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.55 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;-webkit-font-smoothing:antialiased}
a{color:var(--accent)}
.wrap{max-width:1080px;margin:0 auto;padding:20px 16px 64px}
.topbar{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:14px}
.brand{font-weight:700;letter-spacing:-.01em;color:var(--accent);font-size:1rem;text-decoration:none}
.iconbtn{display:inline-flex;align-items:center;gap:6px;border:1px solid var(--line);background:var(--card);color:var(--ink);padding:7px 12px;border-radius:999px;font:inherit;font-size:.88rem;cursor:pointer}
.iconbtn svg{width:16px;height:16px}
.iconbtn:hover{border-color:var(--muted)}
.mytopics{display:flex;align-items:center;gap:12px;background:var(--card);border:1px solid var(--line);border-radius:14px;padding:12px 14px;margin:18px 0 4px;cursor:pointer;width:100%;text-align:left;font:inherit;color:inherit}
.mytopics .t{display:block;font-weight:600;font-size:.92rem}.mytopics .s{display:block;color:var(--muted);font-size:.82rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.mytopics .grow{flex:1;min-width:0}.mytopics .act{flex:none;color:var(--accent);font-weight:600;font-size:.88rem}
/* settings panel */
dialog.settings{border:0;padding:0;border-radius:18px;width:min(640px,100vw - 24px);max-height:min(860px,100vh - 24px);background:var(--card);color:var(--ink);box-shadow:var(--shadow)}
dialog.settings::backdrop{background:rgba(15,23,42,.45)}
@media (max-width:600px){dialog.settings{width:100vw;max-width:100vw;height:100%;max-height:100%;border-radius:0;margin:0}}
.sheet{display:flex;flex-direction:column;max-height:inherit;height:100%}
.sheet header{display:flex;align-items:center;justify-content:space-between;padding:16px 18px;border-bottom:1px solid var(--line)}
.sheet header h2{margin:0;font-size:1.1rem}
.sheet .close{border:0;background:none;color:var(--soft);font-size:1.4rem;line-height:1;cursor:pointer;padding:4px 8px}
.sheet .content{overflow:auto;padding:4px 18px 18px;flex:1}
.sheet h3{font-size:.75rem;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);margin:22px 0 8px;display:flex;justify-content:space-between;align-items:center}
.sheet h3 button{border:0;background:none;color:var(--accent);font:inherit;font-size:.75rem;font-weight:600;text-transform:none;letter-spacing:0;cursor:pointer}
.sheet .help{color:var(--soft);font-size:.9rem;margin:14px 0 0}
.opt{display:flex;gap:12px;align-items:flex-start;padding:11px 12px;border:1px solid var(--line);border-radius:12px;margin-bottom:8px;cursor:pointer}
.opt:hover{border-color:var(--muted)}
.opt input{margin:3px 0 0;width:18px;height:18px;accent-color:var(--accent);flex:none}
.opt .n{font-weight:600;font-size:.93rem}.opt .c{color:var(--muted);font-size:.8rem}
.opt:has(input:checked){border-color:var(--accent);background:var(--accent-bg)}
.seg{display:flex;background:var(--bg);border-radius:10px;padding:3px;gap:3px}
.seg label{flex:1;text-align:center;padding:7px;border-radius:8px;font-size:.88rem;cursor:pointer;color:var(--soft)}
.seg input{position:absolute;opacity:0;pointer-events:none}
.seg label:has(input:checked){background:var(--card);color:var(--ink);font-weight:600;box-shadow:0 1px 3px rgba(0,0,0,.08)}
.sheet footer{padding:14px 18px;border-top:1px solid var(--line);display:flex;gap:10px}
.primary{flex:1;border:0;background:var(--accent);color:var(--accent-ink);padding:12px 16px;border-radius:12px;font:inherit;font-weight:600;cursor:pointer}
.secondary{border:1px solid var(--line);background:none;color:var(--ink);padding:12px 16px;border-radius:12px;font:inherit;cursor:pointer}
.toast{position:fixed;left:50%;bottom:24px;transform:translateX(-50%);background:var(--ink);color:var(--card);padding:11px 16px;border-radius:12px;font-size:.9rem;box-shadow:var(--shadow);max-width:calc(100vw - 32px);z-index:10}
.hidden{display:none!important}
</style>
