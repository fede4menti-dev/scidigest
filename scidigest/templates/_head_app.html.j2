<link rel="manifest" href="{{ root }}manifest.webmanifest">
<link rel="apple-touch-icon" href="{{ root }}apple-touch-icon.png">
<link rel="icon" type="image/png" href="{{ root }}icon-192.png">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="SciDigest">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<meta name="theme-color" content="#0f766e">
<script>
/* Images: retry once after a short pause (Wikimedia sometimes refuses a burst of requests), then fall back to the placeholder. */
function sdImgErr(img){if(!img.dataset.retry){img.dataset.retry="1";var s=img.src;setTimeout(function(){img.src=s+(s.indexOf("?")<0?"?":"&")+"retry=1"},1800)}else if(img.parentNode){img.parentNode.removeChild(img)}}
</script>
