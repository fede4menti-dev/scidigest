{# Settings sheet shared by every page. Behaviour lives in app.js. #}
<dialog class="settings" id="settings" aria-labelledby="settings-title">
  <div class="sheet">
    <header><h2 id="settings-title">Settings</h2><button type="button" class="close" data-close aria-label="Close">×</button></header>
    <div class="content">

      <section aria-labelledby="s-account">
        <h3 id="s-account">Account</h3>
        <div id="account-box"></div>
      </section>

      <section aria-labelledby="s-topics">
        <h3 id="s-topics">Your topics</h3>
        <p class="help" style="margin-top:0">Choose the fields you want to read about. Every daily digest and every weekly and monthly review will show these first. Changing topics costs nothing: papers are re-sorted on your device.</p>
        <label class="opt" style="margin-top:12px"><input type="checkbox" id="all-topics"><span><span class="n">All topics</span><br><span class="c">The editor's picks across every field</span></span></label>
        {% for g in taxonomy %}
        <h4 class="grp"><span>{{ g.name }}</span><button type="button" class="selgroup" data-group="{{ g.id }}">Select all</button></h4>
        {% for t in g.topics %}
        <label class="opt"><input type="checkbox" name="topic" value="{{ t.id }}" data-group="{{ g.id }}"><span><span class="n">{{ t.name }}</span><br><span class="c">{{ t.covers|capitalize }}</span></span></label>
        {% endfor %}{% endfor %}
      </section>

      <section aria-labelledby="s-reading">
        <h3 id="s-reading">Reading</h3>
        <div class="setrow"><span class="n">Text size</span>
          <div class="seg small" role="radiogroup" aria-label="Text size">
            <label><input type="radio" name="size" value="s"><span style="font-size:.8em">A</span></label>
            <label><input type="radio" name="size" value="m">A</label>
            <label><input type="radio" name="size" value="l"><span style="font-size:1.15em">A</span></label>
            <label><input type="radio" name="size" value="xl"><span style="font-size:1.3em">A</span></label>
          </div></div>
        <label class="setrow switch"><span><span class="n">Data saver</span><br><span class="c">Don't load images</span></span><input type="checkbox" id="opt-saver" role="switch"></label>
        <label class="setrow switch"><span><span class="n">Reduce motion</span><br><span class="c">Turn off animations</span></span><input type="checkbox" id="opt-motion" role="switch"></label>
        <label class="setrow switch"><span><span class="n">Dim papers I've read</span><br><span class="c">Papers you opened fade slightly</span></span><input type="checkbox" id="opt-dimread" role="switch"></label>
      </section>

      <section aria-labelledby="s-look">
        <h3 id="s-look">Appearance</h3>
        <div class="seg" role="radiogroup" aria-label="Appearance">
          <label><input type="radio" name="theme" value="">System</label>
          <label><input type="radio" name="theme" value="light">Light</label>
          <label><input type="radio" name="theme" value="dark">Dark</label>
        </div>
      </section>

      <section aria-labelledby="s-idea">
        <h3 id="s-idea">Server for Idea Check and accounts</h3>
        <label class="field"><span>Server address</span><input type="url" id="idea-url" inputmode="url" autocomplete="off" spellcheck="false" placeholder="{{ idea_url or 'https://scidigest-idea-checker.yourname.workers.dev' }}"></label>
        <label class="field"><span>App token (only if you set one)</span><input type="password" id="idea-token" autocomplete="off"></label>
        <p class="help" style="margin-top:4px">{% if idea_url %}Leave the address empty to use this site's server.{% else %}Needed for the full Idea Check report and for accounts. See IDEA-CHECKER-SETUP.md.{% endif %}</p>
      </section>

      <section aria-labelledby="s-data">
        <h3 id="s-data">Data and privacy</h3>
        <div class="btnlist">
          <button type="button" class="listbtn" id="export-data">Export my data<small>Settings, saved papers and idea checks as a file</small></button>
          <button type="button" class="listbtn" id="clear-history">Clear reading history and saved papers</button>
          <button type="button" class="listbtn danger" id="reset-all">Reset everything on this device</button>
          <a class="listbtn" href="{{ root }}privacy.html">Privacy policy</a>
          <a class="listbtn" href="{{ root }}terms.html">Terms of service</a>
          <a class="listbtn" href="{{ root }}cookies.html">Cookies and storage</a>
          <a class="listbtn" href="{{ root }}credits.html">Credits and licenses</a>
        </div>
      </section>

      <section aria-labelledby="s-about">
        <h3 id="s-about">About</h3>
        <p class="help" style="margin-top:0"><strong>SciDigest</strong> picks the most important new research each day from about 40 journals (Nature, Science, Cell, NEJM, The Lancet and more) and arXiv preprints, and explains it for science students. Summaries are written by AI from abstracts and open-access papers, and every paper links to its source.</p>
        <p class="help">Version 1.4 · Updated {{ build }}</p>
        <div class="btnlist" style="margin-top:12px">
          <a class="listbtn" href="{{ contact_url }}" target="_blank" rel="noopener">Contact, feedback or report a problem</a>
          <button type="button" class="listbtn" id="install-help">Add SciDigest to your home screen</button>
        </div>
      </section>
    </div>
    <footer><button type="button" class="secondary" data-close>Cancel</button><button type="button" class="primary" id="save-settings">Save and refresh papers</button></footer>
  </div>
</dialog>
<script>window.SCIDIGEST={{ {"root": root, "ideaUrl": idea_url, "topics": topic_names, "page": active, "build": build, "legalVersion": legal_version}|tojson }};</script>
<script src="{{ root }}app.js" defer></script>
