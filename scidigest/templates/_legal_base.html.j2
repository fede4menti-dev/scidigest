<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}{% endblock %} · SciDigest</title>
{% include "_base_css.html.j2" %}
{% include "_head_app.html.j2" %}
<style>
.doc{border-radius:24px;padding:22px 24px;max-width:820px}
.doc h1{font-size:2rem;letter-spacing:-.025em;margin:0 0 4px}
.doc .upd{color:var(--muted);font-size:.85rem;margin:0 0 18px}
.doc h2{font-size:1.15rem;margin:28px 0 8px}
.doc p,.doc li{color:var(--soft);font-size:.97rem}
.doc li{margin-bottom:6px}
.doc table{width:100%;border-collapse:collapse;font-size:.9rem;margin:8px 0}
.doc th,.doc td{text-align:left;padding:8px 10px;border-bottom:1px solid var(--line);vertical-align:top;color:var(--soft)}
.doc th{color:var(--ink);font-weight:600}
.doc .box{background:var(--accent-bg);border-radius:14px;padding:12px 14px;color:var(--ink)}
</style>
</head>
<body><div class="wrap">
{% include "_topbar.html.j2" %}
<main id="main" class="glass doc">
{% block body %}{% endblock %}
</main>
{% include "_footer.html.j2" %}
</div>
{% include "_settings.html.j2" %}
</body></html>
