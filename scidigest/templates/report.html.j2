<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<style>
:root{--bg:#fbfaf7;--card:#fff;--ink:#1d1d1f;--muted:#5f6368;--line:#e6e2da;--accent:#2f5d8a;--chip:#eef3f8;--okbg:#e8f4ec;--ok:#2d6a3e}
@media (prefers-color-scheme:dark){:root{--bg:#141517;--card:#1c1d20;--ink:#ececec;--muted:#a3a7ad;--line:#2c2e33;--accent:#8db6e0;--chip:#24303d;--okbg:#1f3326;--ok:#8fd0a2}}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:17px/1.6 Georgia,"Iowan Old Style",serif}
main{max-width:760px;margin:0 auto;padding:40px 16px 80px}
header h1{font-size:2rem;margin:0 0 4px;letter-spacing:-.01em}
.sub{color:var(--muted);font-family:system-ui,sans-serif;font-size:.9rem}
.note{background:var(--chip);padding:10px 14px;border-radius:8px;font-family:system-ui,sans-serif;font-size:.9rem;margin-top:16px}
nav{margin:28px 0;padding:16px 20px;border:1px solid var(--line);border-radius:10px;background:var(--card);font-family:system-ui,sans-serif;font-size:.92rem}
nav ol{margin:6px 0 0;padding-left:20px}
nav a{color:var(--ink);text-decoration:none}nav a:hover{color:var(--accent)}
article{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:26px 28px;margin:22px 0}
.meta{display:flex;flex-wrap:wrap;gap:6px;font-family:system-ui,sans-serif;font-size:.78rem;margin-bottom:10px}
.chip{background:var(--chip);color:var(--accent);padding:3px 9px;border-radius:99px}
.chip.ok{background:var(--okbg);color:var(--ok)}
article h2{font-size:1.4rem;line-height:1.3;margin:4px 0 6px}
.orig{color:var(--muted);font-style:italic;font-size:.92rem;margin:0 0 4px}
.dates{color:var(--muted);font-family:system-ui,sans-serif;font-size:.82rem;margin:0 0 14px}
.intro{font-size:1.05rem;margin:16px 0 0}
h3{font-family:system-ui,sans-serif;font-size:.78rem;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);margin:18px 0 4px}
dl{margin:0;font-size:.95rem}dt{font-weight:bold;display:inline}dd{display:inline;margin:0}dd::after{content:"";display:block;margin-bottom:4px}
sup a{color:var(--accent);text-decoration:none;font-family:system-ui,sans-serif;font-size:.75rem}
.src{font-family:system-ui,sans-serif;font-size:.88rem;margin-top:16px}
.src a{color:var(--accent)}
.refs{font-size:.88rem}.refs li{margin-bottom:8px;overflow-wrap:anywhere}
footer{color:var(--muted);font-size:.85rem;margin-top:30px;font-family:system-ui,sans-serif}
</style>
</head>
<body><main>
<header>
  <h1>{{ title }}</h1>
  <div class="sub">{{ subtitle }}</div>
  {% if intro %}<p class="intro">{{ intro }}</p>{% endif %}
  {% if not ai %}<div class="note">Generated without AI: the text under each paper is the publisher's abstract, quoted rather than paraphrased.</div>{% endif %}
</header>
<nav><strong>{{ "Top papers" if is_review else "Today's picks" }}</strong><ol>
{% for e in entries %}<li><a href="#p{{ e.n }}">{{ e.s.headline }}</a> <span class="sub">({{ e.pick.field }})</span></li>{% endfor %}
</ol></nav>
{% for e in entries %}
<article id="p{{ e.n }}">
  <div class="meta"><span class="chip">{{ e.pick.field }}</span><span class="chip">{{ e.article.journal }}</span><span class="chip">Significance {{ e.pick.score }}/10</span>{% if e.s.based_on %}<span class="chip {{ 'ok' if e.s.based_on == 'full text' else '' }}">Summarised from {{ e.s.based_on }}</span>{% endif %}</div>
  <h2>{{ e.n }}. {{ e.s.headline }}</h2>
  <p class="orig">Original title: “{{ e.article.title }}”</p>
  <p class="dates">{{ e.published_label }}{% if e.featured_label %} · {{ e.featured_label }}{% endif %}</p>
  {% for para in e.s.summary.split("\n") if para.strip() %}<p>{{ para }}{% if loop.last %}<sup><a href="#ref{{ e.n }}">[{{ e.n }}]</a></sup>{% endif %}</p>{% endfor %}
  <h3>Why it matters</h3><p>{{ e.s.why_it_matters }}</p>
  {% if e.s.limitations %}<h3>Caveats</h3><p>{{ e.s.limitations }}</p>{% endif %}
  {% if e.s.key_terms %}<h3>Key terms</h3><dl>{% for t in e.s.key_terms %}<dt>{{ t.term }}:</dt> <dd>{{ t.meaning }}</dd>{% endfor %}</dl>{% endif %}
  <div class="src">Source: <a href="{{ e.url }}" target="_blank" rel="noopener">{{ e.url }}</a>
  {% if e.free %}<br>Free to read: <a href="{{ e.free.url }}" target="_blank" rel="noopener">{{ e.free.version }}</a> <span class="sub">via {{ e.free.host }}{% if e.free.license %}, {{ e.free.license }}{% endif %}</span>{% endif %}</div>
</article>
{% endfor %}
<h2>References</h2>
<ol class="refs">{% for e in entries %}<li id="ref{{ e.n }}">{{ e.citation|md_italics }}</li>{% endfor %}</ol>
<footer>Summaries are paraphrased{% if ai %} by an AI model{% endif %} from each paper's abstract, plus its full text when a free, legal copy was available (marked on each paper). Free copies are found through Europe PMC and Unpaywall; preprints and accepted manuscripts can differ slightly from the final published paper. Check the original paper before citing it in your own work.</footer>
</main></body></html>
